# === Configuración del servidor MCP MWT.ONE ===

# Base de la API REST (incluye el sufijo /api). Producción:
MWT_API_BASE=https://consola.mwt.one/api

# Token de servicio de larga vida (generado con `manage.py mint_mcp_token`).
# Pegalo aquí completo, en una sola línea.
MWT_MCP_TOKEN=PEGA_AQUI_EL_TOKEN

# Transporte MCP: "stdio" (default, para Antigravity / Kimi CLI / Claude Desktop)
# o "http" (streamable-http, para clientes que se conectan por red).
MWT_MCP_TRANSPORT=stdio

# Solo si MWT_MCP_TRANSPORT=http:
MWT_MCP_HOST=0.0.0.0
MWT_MCP_PORT=8765

# Timeout por request HTTP (segundos).
MWT_HTTP_TIMEOUT=60

# Modo solo-lectura: si es "1"/"true", se bloquean todas las herramientas que
# crean/editan/borran (útil para dar acceso de auditoría a un agente).
MWT_MCP_READONLY=0
