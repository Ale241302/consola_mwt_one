# =====================================================================
# Consola MWT.ONE · .env.example
# Copia este archivo a `.env` y rellena los valores reales antes de
# ejecutar `docker compose up -d`.
# =====================================================================

# --- Django ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
DJANGO_DEBUG=0

# Hosts aceptados (coma-separados). Añade tu dominio cuando apuntes DNS.
# Ejemplo:  localhost,127.0.0.1,187.77.218.102,consola.muitowork.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,187.77.218.102,consola.mwt.one

# Orígenes válidos para CORS y CSRF (coma-separados, con esquema+host+puerto).
# Cuando actives HTTPS incluye ambas versiones (http:// y https://).
DJANGO_CORS_ALLOWED_ORIGINS=http://187.77.218.102:3100,http://187.77.218.102:8100,https://consola.mwt.one,http://consola.mwt.one
DJANGO_CSRF_TRUSTED_ORIGINS=http://187.77.218.102:3100,http://187.77.218.102:8100,https://consola.mwt.one,http://consola.mwt.one

# --- PostgreSQL ------------------------------------------------------
DB_PASSWORD=mwt

# --- SMTP / Email ----------------------------------------------------
# Si EMAIL_HOST_PASSWORD queda VACÍO, Django cae a console.EmailBackend
# y los emails solo se imprimen en stdout del container (debug).
# Setealos para que reset-password, notificaciones, etc. envíen real.
EMAIL_HOST=mail.mwt.one
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@mwt.one
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@mwt.one
EMAIL_TIMEOUT=20
# Cuenta secundaria para envío de proformas/documentos comerciales
EMAIL_DOC_USER=mw_doc@mwt.one
EMAIL_DOC_PASSWORD=
DEFAULT_REPLY_TO=trade@mwt.one

# --- (Opcional) MinIO/Paperless --------------------------------------
# MINIO_ROOT_USER=mwt-access
# MINIO_ROOT_PASSWORD=mwt-secret
# PAPERLESS_SECRET_KEY=paperless-change-me

# --- Builder externo (catálogo dinámico de artefactos) --------------
# El backend hace login al Builder con estas credenciales y cachea el
# JWT por 4 min. Si BUILDER_PASSWORD queda vacío, los endpoints
# /api/builder/templates/* devolverán 502.
BUILDER_API_BASE=https://builder.muito.work/api
BUILDER_USERNAME=Admin
BUILDER_PASSWORD=MuitoWork2026?
BUILDER_TOKEN_TTL_S=240
