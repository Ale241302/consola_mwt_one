# --- Django ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
DJANGO_DEBUG=0

# --- PostgreSQL ------------------------------------------------------
DB_PASSWORD=mwt

# --- (Opcional) MinIO/Paperless --------------------------------------
# MINIO_ROOT_USER=mwt-access
# MINIO_ROOT_PASSWORD=mwt-secret
# PAPERLESS_SECRET_KEY=paperless-change-me
