# =====================================================================
# Consola MWT.ONE · .env.example
# Copia este archivo a `.env` y rellena los valores reales antes de
# ejecutar `docker compose up -d`.
# =====================================================================

# --- Django ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
DJANGO_DEBUG=0

# Hosts aceptados (coma-separados). Añade tu dominio cuando apuntes DNS.
# Ejemplo:  localhost,127.0.0.1,187.77.218.102,consola.muitowork.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,187.77.218.102

# Orígenes válidos para CORS y CSRF (coma-separados, con esquema+host+puerto).
# Cuando actives HTTPS incluye ambas versiones (http:// y https://).
DJANGO_CORS_ALLOWED_ORIGINS=http://187.77.218.102:3100,http://187.77.218.102:8100
DJANGO_CSRF_TRUSTED_ORIGINS=http://187.77.218.102:3100,http://187.77.218.102:8100

# --- PostgreSQL ------------------------------------------------------
DB_PASSWORD=mwt

# --- (Opcional) MinIO/Paperless --------------------------------------
# MINIO_ROOT_USER=mwt-access
# MINIO_ROOT_PASSWORD=mwt-secret
# PAPERLESS_SECRET_KEY=paperless-change-me
