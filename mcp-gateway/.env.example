# =====================================================================
# MWT.ONE · MCP Gateway — variables de entorno (copiar a .env y rellenar)
# =====================================================================

# ----------------------------------------------------------------------
# Pocket-ID
# ----------------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrado de tokens/secrets de Pocket-ID.
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=__REPLACE_ME__

# ----------------------------------------------------------------------
# ContextForge
# ----------------------------------------------------------------------
# HMAC secret para JWT internos (32+ chars). Generar con openssl rand -base64 32
JWT_SECRET_KEY=__REPLACE_ME__

# Passphrase para cifrado de credenciales almacenadas. Generar con openssl rand -base64 32
AUTH_ENCRYPTION_SECRET=__REPLACE_ME__

# Admin bootstrap de la UI/API de ContextForge
PLATFORM_ADMIN_EMAIL=admin@mwt.one
PLATFORM_ADMIN_PASSWORD=__REPLACE_ME__
PLATFORM_ADMIN_FULL_NAME="MWT Gateway Admin"

# Basic auth para API endpoints (si se usa; ContextForge lo inicializa con init_secrets).
BASIC_AUTH_PASSWORD=__REPLACE_ME__

# ----------------------------------------------------------------------
# MWT MCP Server (también se usa en el stack consola-mwt-one .env)
# ----------------------------------------------------------------------
# Token de servicio generado con:
#   docker exec -i consola-mwt-one-django python manage.py mint_mcp_token \
#     --email alejandro@muitowork.com --quiet
MWT_MCP_TOKEN=__REPLACE_ME__
MWT_API_BASE=https://consola.mwt.one/api
