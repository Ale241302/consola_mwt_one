# MWT.ONE Frontend — variables de entorno de ejemplo
# Copiar a .env.local y ajustar según el entorno.

# Base URL del backend Django (sin barra final).
# En producción: https://consola.mwt.one
VITE_API_BASE_URL=http://localhost:8000

# Modo mock: cuando es "1" o "true", el frontend NO pega al backend salvo
# /auth/*. Útil únicamente para demos offline o desarrollo sin backend.
# En producción SIEMPRE debe ser "0".
VITE_USE_MOCKS=0
